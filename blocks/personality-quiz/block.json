{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "personality-assessment/quiz",
	"version": "1.0.0",
	"title": "Personality Quiz",
	"category": "widgets",
	"icon": "forms",
	"description": "Displays a personality quiz.",
	"attributes": {
		"quizId": {
			"type": "string"
